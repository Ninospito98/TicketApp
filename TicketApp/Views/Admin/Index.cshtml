@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-section">
    <div class="admin-wrapper">
        <h1 class="admin-title">Dashboard</h1>

        <div class="admin-cards">
            <div class="admin-card">
                <span class="admin-card-icon">🎫</span>
                <h2>Events</h2>
                <p>Create, edit and delete events</p>
                <a asp-controller="Admin" asp-action="Events" class="admin-card-btn">Manage Events</a>
            </div>

            <div class="admin-card">
                <span class="admin-card-icon">👥</span>
                <h2>Users</h2>
                <p>View and manage users</p>
                <a asp-controller="Admin" asp-action="Users" class="admin-card-btn">Manage Users</a>
            </div>

            <div class="admin-card">
                <span class="admin-card-icon">🎟️</span>
                <h2>Bookings</h2>
                <p>View all bookings</p>
                <a asp-controller="Admin" asp-action="Bookings" class="admin-card-btn">View Bookings</a>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}