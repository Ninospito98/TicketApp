@model List<TicketApp.Models.UserViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<section class="admin-section ">
    <div class="admin-wrapper ">
        <div class="admin-header">
            <h1 class="admin-title">Manage Users</h1>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                        <td class="action-btns">
                            <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-primary edit-btn">Edit</a>
                            <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post">
                                <button type="submit" class="btn btn-danger delete-btn">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
