@model List<TicketApp.Models.Event>

@{
    ViewData["Title"] = "Manage Events";
}

<section class="admin-section">
    <div class="admin-wrapper">
        <div class="admin-header">
            <h1 class="admin-title">Manage Events</h1>
            <a asp-controller="Event" asp-action="Create" class="admin-card-btn">+ Create Event</a>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Venue</th>
                    <th>Price</th>
                    <th>Tickets</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>@ev.Title</td>
                        <td>@ev.Category</td>
                        <td>@ev.Date.ToString("dd MMM yyyy")</td>
                        <td>@ev.Venue</td>
                        <td>@ev.Price SEK</td>
                        <td>@ev.TicketsRemaining / @ev.TotalTickets</td>
                        <td class="action-btns">
                            <a asp-controller="Event" asp-action="Edit" asp-route-id="@ev.Id" class="edit-btn btn btn-primary">Edit</a>
                            <form asp-controller="Event" asp-action="Delete" asp-route-id="@ev.Id" method="post">
                                <button type="submit" class="btn btn-danger delete-btn">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}