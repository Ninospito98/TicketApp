@{
    ViewData["Title"] = "Invalid Ticket";
}

<section class="checkin-section">
    <div class="checkin-wrapper">
        <div class="verify-card used">
            <div class="verify-status">
                <span class="status-icon red">✕</span>
                <h2>Invalid Ticket</h2>
                <p>This ticket code does not exist in the system</p>
            </div>
            <a asp-action="Index" class="scan-again-btn">Scan Again</a>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/checkin.css" />
}