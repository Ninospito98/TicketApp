@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TicketApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="main-nav">
            <div class="nav-left">
                <a class="nav-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    🎫 TicketApp
                </a>
                <div class="nav-links">
                    <a asp-controller="Event" asp-action="Index">Events</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Booking" asp-action="MyTickets">My Tickets</a>
                    }
                    @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                    {
                        <a asp-controller="CheckIn" asp-action="Index">Check In</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                    }
                </div>
            </div>
            <div class="nav-right">
                <partial name="_LoginPartial.cshtml" />
            </div>
        </nav>
    </header>
    <div>
            @RenderBody()
    </div>

    <footer class="border-top footer text-muted text-center">
        <div class="container">
            &copy; 2026 - TicketApp | Developed by <span style="color:orange;">Ninos Pito</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
